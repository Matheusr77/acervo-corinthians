# ---- Servidor ----
PORT=3000
# development | production (em produção esconde detalhes de erro e ativa cache de arquivos)
NODE_ENV=development

# URL pública do site (links de compartilhamento e sitemap). Opcional em desenvolvimento.
SITE_URL=

# ---- Banco de dados MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=corinthians_db
DB_CONNECTION_LIMIT=10
# Conexão segura (necessária em bancos na nuvem, ex.: Aiven)
DB_SSL=false
# Conteúdo do certificado CA (PEM) da hospedagem — opcional, mas recomendado com DB_SSL=true
DB_SSL_CA=

# ---- Domínio ----
# id_time do Corinthians na tabela `time` (separe por vírgula se houver mais de um).
# O scraping criou um segundo registro (1014) para os jogos a partir de dez/1947.
# Depois de rodar database/correcoes/001-unificar-corinthians.sql, pode usar só 1.
CORINTHIANS_IDS=1,1014

# ---- Escudos (npm run escudos) ----
# Seu e-mail: a Wikimedia pede um contato no User-Agent de scripts
ESCUDOS_CONTATO=

# ---- Correções enviadas pela torcida ("Achou um erro? Avise") ----
# Senha do painel /admin/correcoes (use um texto longo e aleatório, ex.: openssl rand -hex 24).
# Sem ela, o formulário continua recebendo avisos, mas o painel fica desligado.
ADMIN_TOKEN=
# Pasta onde os avisos são gravados (padrão: data/). Em hospedagens com disco temporário,
# aponte para um volume persistente.
DATA_DIR=
